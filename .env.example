# Airtable — primary RSVP storage. When set, guest RSVPs are saved here and,
# for guests attending, a unique Access Code + QR check-in token are generated
# and saved back to the record. If unset, RSVP falls back to the Google Sheets
# webhook / email path below (no Access Code is issued via that path).
#
# Required columns in the table: Name, Email, Phone, Will you attend?,
# Number of guests, Message to the couple, Access code, QR code, Checked In,
# Check-In time.
#
# Optional columns for personal invite links (/rsvp/[code]) that cap how many
# guests a specific family can bring: Invite code (text, unique per invited
# family) and Max guests (number). Add a row per invited family with just
# Name + Invite code + Max guests filled in ahead of time, then share
# https://<your-domain>/rsvp/<their Invite code> with that family. Guests who
# use the open /details#rsvp form instead (no invite code) are unaffected.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# Admin — password to view/manage guest check-in later.
ADMIN_PASSWORD=

# URL of the deployed Google Apps Script web app that appends RSVP rows to a Google Sheet.
# See scripts/google-apps-script.js for the script to paste into script.google.com.
GOOGLE_SHEETS_WEBHOOK_URL=

# Fallback email, sent only if Airtable isn't configured (or fails) and the
# Google Sheet webhook above also fails (or isn't configured).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RSVP_NOTIFICATION_EMAIL=
