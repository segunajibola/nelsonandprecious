# Airtable — required. RSVP is invite-only: guests can only respond through a
# personal link generated in /admin (see ADMIN_PASSWORD below), which is
# looked up here. There's no public/open RSVP form.
#
# Required columns in the table: Name, Email, Phone, Will you attend?,
# Number of guests, Message to the couple, Access code, QR code, Checked In,
# Check-In time, Invite code, Max guests.
#
# Generate invites at /admin — you set a guest's name (fixed, they can't
# change it) and their max guest count; the Invite code is generated for you.
# Share the resulting https://<your-domain>/rsvp/<code> link with that guest.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# Optional — each of these is a separate table in the same Airtable base
# (same AIRTABLE_TOKEN/AIRTABLE_BASE_ID). Leave any of them blank to disable
# that feature entirely; the site falls back gracefully.
#
# Guestbook (/guestbook, moderated at /admin/guestbook) — columns:
# Name, Message, Approved (checkbox).
AIRTABLE_GUESTBOOK_TABLE=
# Song requests (/songs, viewed at /admin/songs) — columns: Name, Song.
AIRTABLE_SONGS_TABLE=
# Shared photos (/share-photos) — columns: Name, Message, Photo (attachment).
AIRTABLE_PHOTOS_TABLE=

# Admin — password to generate/manage guest invites at /admin.
ADMIN_PASSWORD=

# Resend — required. Sends two kinds of email:
# 1. The guest's own confirmation (wedding details + their Access Code) after
#    they RSVP "yes" via their personal invite link.
# 2. An alert to RSVP_NOTIFICATION_EMAIL if saving to Airtable ever fails, so
#    the RSVP isn't silently lost. Comma-separate multiple addresses to
#    notify more than one person, e.g. "nelson@x.com, precious@x.com".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RSVP_NOTIFICATION_EMAIL=

# Base URL of the deployed site — used to link back to /details from the
# guest's confirmation email, and to build the /checkin/[token] link encoded
# in each guest's QR code. Defaults to the production Vercel URL if unset.
SITE_URL=https://preciousandnelson.vercel.app
